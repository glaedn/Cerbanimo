GEMINI_API_KEY="YOUR_API_KEY_HERE"
GEMINI_PROJECT_PLAN_MODEL=gemini-3.1-flash-lite
GEMINI_TASK_GRAPH_MODEL=gemini-3.1-flash-lite
# Optional. When blank, Cerbanimo reuses GEMINI_TASK_GRAPH_MODEL for the post-generation
# task graph refinement pass that splits vague or oversized tasks before persistence.
GEMINI_TASK_GRAPH_REFINEMENT_MODEL=gemini-3.1-flash-lite
GEMINI_REQUEST_TIMEOUT_MS=60000
GEMINI_TASK_GRAPH_REFINEMENT_TIMEOUT_MS=60000
GEMINI_TASK_GRAPH_REFINEMENT_MAX_OUTPUT_TOKENS=8192
CERBANIMO_TASK_REFINEMENT_MAX_PASSES=2
CERBANIMO_TASK_REFINEMENT_MAX_TASKS=60
CERBANIMO_TASK_REFINEMENT_MAX_GROWTH_PERCENT=250
CERBANIMO_TASK_REFINEMENT_MIN_MEGA_TASK_EXPANSION_BUFFER=16
CERBANIMO_TASK_REFINEMENT_MAX_PROMPT_CHARS=50000
VITE_AUTH0_DOMAIN=dev-i5331ndl5kxve1hd.us.auth0.com
VITE_AUTH0_CLIENT_ID=your_auth0_spa_client_id
VITE_BACKEND_URL=http://localhost:4000
VITE_AUTH_BRIDGE_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:3001

# Local-only Cerbanimo auth bypass for browser validation.
# Never enable in production. Backend and frontend token values must match.
VITE_CERBANIMO_DEV_AUTH_BYPASS=false
VITE_CERBANIMO_DEV_AUTH_TOKEN=replace-with-a-local-random-token
VITE_CERBANIMO_DEV_AUTH_SUB=auth0|cerbanimo-dev-test
VITE_CERBANIMO_DEV_AUTH_EMAIL=cerbanimo-dev-test@example.test
VITE_CERBANIMO_DEV_AUTH_NAME="Cerbanimo Dev Tester"
VITE_CERBANIMO_DEV_AUTH_USERNAME=cerbanimo-dev-test

# Local-only backend side of the browser-validation auth bypass.
# Set CERBANIMO_DEV_AUTH_BYPASS=true only in local development/test.
# CERBANIMO_DEV_AUTH_TOKEN must match VITE_CERBANIMO_DEV_AUTH_TOKEN.
CERBANIMO_DEV_AUTH_BYPASS=false
CERBANIMO_DEV_AUTH_TOKEN=replace-with-a-local-random-token
CERBANIMO_DEV_AUTH_SUB=auth0|cerbanimo-dev-test
CERBANIMO_DEV_AUTH_EMAIL=cerbanimo-dev-test@example.test
CERBANIMO_DEV_AUTH_NAME="Cerbanimo Dev Tester"
CERBANIMO_DEV_AUTH_USERNAME=cerbanimo-dev-test

# Server-side quality-check executor.
# Keep blank unless Cerbanimo has a sandboxed executor configured.
# "deterministic" is reserved for guarded E2E tests only.
CERBANIMO_QUALITY_CHECK_EXECUTOR=
