PORT=4000
DATABASE_URL=your_database_url
FRONTEND_URL=https://cerbanimo.onrender.com
BACKEND_URL=http://localhost:4000
GEMINI_API_KEY=your_gemini_api_key
KAMIYA_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:3001

# Quality-check automation executor.
# Leave blank in production until a real sandbox executor is configured.
# Use "deterministic" only for protected E2E test runs with NODE_ENV=test,
# CERBANIMO_E2E_MODE=true, and a database name containing e2e/test.
CERBANIMO_QUALITY_CHECK_EXECUTOR=
